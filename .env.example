# DEPLOY-001 configuration. Copy to .env (git-ignored) and fill in.
# Values in the process environment override this file.
# This file is read as plain KEY=VALUE data. Nothing in it is executed by a shell.
# Never use NEXT_PUBLIC_* for credentials: those are embedded in browser bundles.

# --- Docker build and preview (no Cloudflare credentials needed) ---
DOCKER_IMAGE_NAME=villa-luma
DOCKER_IMAGE_TAG=local
PREVIEW_PORT=4173

# --- Cloudflare Pages Direct Upload (deploy only) ---
# Account ID: Cloudflare dashboard > Account home > Account details.
CLOUDFLARE_ACCOUNT_ID=
# Secret. Account API token with permission Account > Cloudflare Pages > Edit, for this account only.
CLOUDFLARE_API_TOKEN=
# Existing Direct Upload project. Scripts never create projects.
CLOUDFLARE_PAGES_PROJECT_NAME=
# Must match the project's production branch.
CLOUDFLARE_PRODUCTION_BRANCH=
# Branch name used for preview deployments. Must differ from the production branch.
CLOUDFLARE_DEPLOY_BRANCH=preview
# preview (default) or production. Production also requires --confirm-production.
DEPLOY_TARGET=preview
